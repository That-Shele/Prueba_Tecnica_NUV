@page
@{
    ViewData["Title"] = "Soluciones POS para Restaurantes y Tiendas - POS Enterprise";
    ViewData["MetaDescription"] = "Descubre nuestras soluciones especializadas para la industria gastronómica y el sector retail de comercio al por menor.";
}

<section class="hero">
    <h1>Soluciones Especializadas por Sector</h1>
    <p>Adapatamos nuestras funcionalidades a la operativa específica de tu establecimiento.</p>
</section>

<div class="features-grid">
    <section class="card">
        <h2>POS para Restaurantes y Bares</h2>
        <ul>
            <li>Mapa dinámico de mesas y gestión de cuentas divididas.</li>
            <li>Conexión con impresoras de cocina y pantallas KDS.</li>
            <li>Manejo de recetas, subrecetas y descuente de insumos.</li>
        </ul>
        <br />
        <a asp-page="/Contacto" class="btn-cta-nav">Cotizar para Restaurante</a>
    </section>

    <section class="card">
        <h2>POS para Tiendas y Comercio Retail</h2>
        <ul>
            <li>Escaneo rápido con código de barras y variantes de producto.</li>
            <li>Cierre de caja ciego y auditoría de cajeros.</li>
            <li>Emisión de facturación electrónica e impresiones térmicas.</li>
        </ul>
        <br />
        <a asp-page="/Contacto" class="btn-cta-nav">Cotizar para Retail</a>
    </section>
</div>