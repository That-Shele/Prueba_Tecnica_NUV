@page
@model PosEnterprise.Web.Pages.Blog.IndexModel
@{
    ViewData["Title"] = "Blog de Tecnología y Gestión POS - POS Enterprise";
    ViewData["MetaDescription"] = "Artículos, guías y buenas prácticas sobre control de inventarios, comanda digital y administración para restaurantes y tiendas.";
}

<section class="hero">
    <h1>Blog & Recursos de Gestión para Comercios</h1>
    <p>Aprende a optimizar la operativa de tu restaurante o tienda con nuestras guías y artículos especializados.</p>
</section>

<div class="features-grid">
    @foreach (var article in Model.Articles)
    {
        <article class="card">
            <h2>@article.Title</h2>
            <p style="color: #6c757d; font-size: 0.9rem; margin-bottom: 0.5rem;">
                Por <strong>@article.Author</strong> | @article.PublishedAt.ToString("dd 'de' MMMM, yyyy")
            </p>
            <p>@article.Summary</p>
            <br />
            <a asp-page="/Blog/Detail" asp-route-slug="@article.Slug" class="btn-cta-nav">Leer Artículo Completo</a>
        </article>
    }
</div>

@if (Model.TotalPages > 0)
{
    <nav aria-label="Navegación de páginas del blog" style="max-width: 1200px; margin: 2rem auto; padding: 0 1rem; display: flex; justify-content: center; align-items: center; gap: 0.5rem;">
        @if (Model.HasPreviousPage)
        {
            <a asp-page="/Blog/Index" asp-route-p="@(Model.CurrentPage - 1)" class="pagination-link">&laquo; Anterior</a>
        }
        else
        {
            <span class="pagination-link disabled">&laquo; Anterior</span>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            if (i == Model.CurrentPage)
            {
                <span class="pagination-link active" aria-current="page">@i</span>
            }
            else
            {
                <a asp-page="/Blog/Index" asp-route-p="@i" class="pagination-link">@i</a>
            }
        }

        @if (Model.HasNextPage)
        {
            <a asp-page="/Blog/Index" asp-route-p="@(Model.CurrentPage + 1)" class="pagination-link">Siguiente &raquo;</a>
        }
        else
        {
            <span class="pagination-link disabled">Siguiente &raquo;</span>
        }
    </nav>
}