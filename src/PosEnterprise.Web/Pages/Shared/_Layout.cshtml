<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "POS Enterprise - Sistemas de Punto de Venta")</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Sistemas POS integrados para restaurantes y comercios. Optimiza inventarios, ventas y comandas.")" />
    <link asp-canonical="true" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
        <nav class="nav-container" aria-label="Navegación principal">
            <a class="brand-logo" asp-page="/Index">
                <strong>POS Enterprise</strong>
            </a>
            <ul class="nav-menu">
                <li><a asp-page="/Index">Inicio</a></li>
                <li><a asp-page="/Soluciones">Soluciones POS</a></li>
                <li><a asp-page="/Blog/Index">Blog</a></li>
                <li><a asp-page="/Contacto" class="btn-cta-nav">Solicitar Demo</a></li>
            </ul>
        </nav>
    </header>

    <main id="main-content" tabIndex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-container">
            <div>
                <p><strong>POS Enterprise</strong> &copy; @DateTime.Now.Year. Soluciones tecnológicas para comercios y gastronomía.</p>
            </div>
            <ul class="footer-links">
                <li><a asp-page="/Soluciones">Restaurantes y Retail</a></li>
                <li><a asp-page="/Contacto">Contacto</a></li>
                <li><a asp-page="/Admin/Login">Administración</a></li>
            </ul>
        </div>
    </footer>

    @await Html.PartialAsync("_SchemaOrgPartial")
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>