<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "POS Enterprise - Sistemas de Punto de Venta")</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Sistemas POS integrados para restaurantes y comercios. Optimiza inventarios, ventas y comandas.")" />
    <link asp-canonical="true" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/><link href="https://fonts.googleapis.com" rel="preconnect"/><link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <style>
        base { 
            html,body {
                margin:0;
                padding:0;
            }

            body {
                overscroll-behavior:none;
            }

            main>:first-child {
                margin-top:0!important;
            }

            main>:last-child {
                margin-bottom:0!important;
            }
        }
    </style>
    <script src="https://cdn.tailwindcss.com"></script><script id="tailwind-config">tailwind.config={"darkMode":"class","theme":{"extend":{"colors":{"on-surface-variant":"#434655","secondary-fixed":"#dae2fd","surface":"#f8f9ff","tertiary":"#943700","on-primary-container":"#eeefff","inverse-primary":"#b4c5ff","on-surface":"#0b1c30","on-secondary-fixed":"#131b2e","surface-container-highest":"#d3e4fe","surface-container-lowest":"#ffffff","primary-fixed-dim":"#b4c5ff","surface-container-high":"#dce9ff","on-secondary":"#ffffff","background":"#f8f9ff","primary":"#004ac6","on-tertiary-container":"#ffede6","on-secondary-fixed-variant":"#3f465c","surface-container-low":"#eff4ff","on-background":"#0b1c30","error-container":"#ffdad6","secondary-container":"#dae2fd","on-primary":"#ffffff","error":"#ba1a1a","on-primary-fixed":"#00174b","on-error-container":"#93000a","on-error":"#ffffff","secondary-fixed-dim":"#bec6e0","tertiary-fixed":"#ffdbcd","on-tertiary-fixed":"#360f00","surface-dim":"#cbdbf5","outline-variant":"#c3c6d7","tertiary-container":"#bc4800","on-tertiary-fixed-variant":"#7d2d00","surface-container":"#e5eeff","outline":"#737686","on-secondary-container":"#5c647a","tertiary-fixed-dim":"#ffb596","inverse-surface":"#213145","secondary":"#565e74","on-tertiary":"#ffffff","on-primary-fixed-variant":"#003ea8","inverse-on-surface":"#eaf1ff","surface-bright":"#f8f9ff","surface-variant":"#d3e4fe","primary-container":"#2563eb","surface-tint":"#0053db","primary-fixed":"#dbe1ff"},"borderRadius":{"DEFAULT":"0.25rem","lg":"0.5rem","xl":"0.75rem","full":"9999px"},"spacing":{"margin":"2rem","space-lg":"1.5rem","gutter":"1.5rem","space-md":"1rem","margin-mobile":"1rem","space-xl":"2.5rem","space-xs":"0.25rem","space-sm":"0.5rem","gutter-mobile":"1rem"},"fontFamily":{"headline-md":["Inter"],"headline-lg":["Inter"],"label-lg":["Inter"],"display-lg":["Inter"],"body-sm":["Inter"],"headline-lg-mobile":["Inter"],"label-md":["Inter"],"title-md":["Inter"],"body-md":["Inter"],"body-lg":["Inter"],"label-sm":["Inter"],"headline-sm":["Inter"]},"fontSize":{"headline-md":["24px",{"lineHeight":"32px","letterSpacing":"-0.02em","fontWeight":"600"}],"headline-lg":["32px",{"lineHeight":"40px","letterSpacing":"-0.025em","fontWeight":"600"}],"label-lg":["14px",{"lineHeight":"20px","letterSpacing":"-0.005em","fontWeight":"500"}],"display-lg":["40px",{"lineHeight":"48px","letterSpacing":"-0.03em","fontWeight":"600"}],"body-sm":["12px",{"lineHeight":"18px","letterSpacing":"0.005em","fontWeight":"400"}],"headline-lg-mobile":["26px",{"lineHeight":"34px","letterSpacing":"-0.02em","fontWeight":"600"}],"label-md":["12px",{"lineHeight":"16px","letterSpacing":"0.01em","fontWeight":"500"}],"title-md":["16px",{"lineHeight":"24px","letterSpacing":"-0.01em","fontWeight":"600"}],"body-md":["14px",{"lineHeight":"22px","letterSpacing":"0em","fontWeight":"400"}],"body-lg":["16px",{"lineHeight":"26px","letterSpacing":"-0.005em","fontWeight":"400"}],"label-sm":["11px",{"lineHeight":"14px","letterSpacing":"0.04em","fontWeight":"600"}],"headline-sm":["20px",{"lineHeight":"28px","letterSpacing":"-0.015em","fontWeight":"600"}]}}}};</script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    
    <header class="fixed top-0 left-0 w-full z-50 bg-surface-container-lowest/80 backdrop-blur-md border-b border-outline-variant/30">
        <div class="h-16 w-full max-w-7xl mx-auto px-margin flex items-center justify-between">
            <div class="flex items-center gap-space-sm">
                <a class="flex items-center gap-space-xs tracking-tight" asp-page="/Index">
                    <span class="w-2 h-2 rounded-full bg-primary-container"></span>
                    <span class="font-title-md text-title-md font-bold tracking-tight text-on-surface uppercase">POS 
                        <span class="font-normal text-on-surface-variant">Enterprise</span>
                    </span>
                </a>
            </div>
            <nav class="hidden md:flex items-center gap-space-md p-space-xs" data-active-classes="text-on-surface font-semibold bg-surface-container/60 rounded-lg">
                <a class="px-space-md py-space-xs rounded-lg text-on-surface-variant font-label-lg text-label-lg hover:text-on-surface hover:bg-surface-container-low transition-all duration-150" asp-page="/Index">Inicio</a>
                <a class="px-space-md py-space-xs rounded-lg text-on-surface-variant font-label-lg text-label-lg hover:text-on-surface hover:bg-surface-container-low transition-all duration-150" asp-page="/Soluciones">Soluciones POS</a>
                <a class="px-space-md py-space-xs rounded-lg text-on-surface-variant font-label-lg text-label-lg hover:text-on-surface hover:bg-surface-container-low transition-all duration-150" asp-page="/Blog/Index">Blog</a>
            </nav>
            <div class="flex items-center gap-space-md">
                <a class="inline-flex items-center justify-center bg-primary-container hover:bg-primary text-on-primary font-label-lg text-label-lg px-5 py-2 rounded-lg transition-all duration-150 shadow-sm active:scale-[0.99]" asp-page="/Contacto">Solicitar Demo</a>
            </div>
        </div>
    </header>

    <main id="main-content" class="w-full pt-16 bg-surface min-h-[calc(100vh-16rem)]" tabIndex="-1">
        @RenderBody()
    </main>

    <footer class="w-full bg-surface-container-lowest border-t border-outline-variant/30 mt-space-xl">
        <div class="max-w-7xl mx-auto px-margin py-space-xl">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-space-lg pb-space-lg border-b border-outline-variant/20">
                <div class="flex flex-col gap-space-xs">
                    <div class="flex items-center gap-space-xs">
                        <span class="w-1.5 h-1.5 rounded-full bg-primary-container"></span>
                        <span class="font-title-md text-title-md font-bold tracking-tight text-on-surface uppercase">POS <span class="font-normal text-on-surface-variant">Enterprise</span></span>
                    </div>
                    <p class="font-body-sm text-body-sm text-on-surface-variant max-w-sm">Arquitectura transaccional de latencia ultra-baja y precisión automatizada para retail empresarial.</p>
                </div>
                <div class="flex flex-wrap items-center gap-space-lg">
                    <a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="soluciones-pos" href="#">Terminales Hardware</a>
                    <a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="soluciones-pos" href="#">Infraestructura Cloud</a>
                    <a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="blog" href="#">Publicaciones</a>
                    <a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="solicitar-demo" href="#">Contacto</a>
                </div>
            </div>
            <div class="pt-space-md flex flex-col sm:flex-row items-center justify-between gap-space-sm font-label-sm text-label-sm text-on-surface-variant">
                <p>© 2026 POS Enterprise Inc. Todos los derechos reservados.</p>
                <div class="flex items-center gap-space-md">
                    <span class="hover:text-on-surface cursor-pointer transition-colors">Privacidad</span>
                    <span class="hover:text-on-surface cursor-pointer transition-colors">Términos</span>
                    <span class="hover:text-on-surface cursor-pointer transition-colors">Seguridad Bancaria</span>
                </div>
            </div>
        </div>
    </footer>

    @await Html.PartialAsync("_SchemaOrgPartial")
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>