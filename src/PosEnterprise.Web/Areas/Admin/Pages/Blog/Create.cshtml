@page
@model PosEnterprise.Web.Areas.Admin.Pages.Blog.CreateModel
@{
    ViewData["Title"] = "Redactar Artículo - Administración";
}

<!-- Estilos de Quill.js -->
<link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet" />

<div class="editor-card">
    <h2 class="editor-title">Redactar Nuevo Artículo</h2>

    <form method="post" id="blogForm">
        <div class="form-group">
            <label for="Title" class="editor-label">Title</label>
            <input asp-for="Input.Title" id="Title" class="editor-input" placeholder="Título del artículo..." />
            <span asp-validation-for="Input.Title" class="text-danger"></span>
        </div>

        <input type="hidden" asp-for="Input.Slug" id="Slug" />

        <div class="form-group">
            <label for="Summary" class="editor-label">Summary / Extracto</label>
            <textarea asp-for="Input.Summary" id="Summary" class="editor-input" rows="2" placeholder="Breve resumen del artículo para buscadores..."></textarea>
            <span asp-validation-for="Input.Summary" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="editor-label">Description</label>
            <!-- Input oculto que envía el HTML al servidor C# -->
            <input type="hidden" asp-for="Input.Content" id="editorContent" />
            <!-- Contenedor donde se renderiza Quill.js -->
            <div id="quill-editor" style="min-height: 280px; background: #fff;"></div>
            <span asp-validation-for="Input.Content" class="text-danger"></span>
        </div>

        <div class="editor-footer">
            <div class="form-group-inline">
                <label for="Author" class="editor-label">Autor:</label>
                <input asp-for="Input.Author" id="Author" class="editor-input-sm" />
            </div>

            <div class="form-group-checkbox">
                <input asp-for="Input.IsPublished" id="IsPublished" type="checkbox" />
                <label for="IsPublished">Publicar en el Blog</label>
            </div>

            <button type="submit" class="btn-submit">Guardar y Publicar</button>
        </div>
    </form>
</div>

<style>
    .editor-card {
        max-width: 850px;
        margin: 2rem auto;
        padding: 2rem;
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
        border: 1px solid #dee2e6;
    }

    .editor-title {
        margin-bottom: 1.5rem;
        font-size: 1.4rem;
        color: #212529;
    }

    .form-group {
        margin-bottom: 1.25rem;
    }

    .editor-label {
        display: block;
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.4rem;
    }

    .editor-input {
        width: 100%;
        padding: 0.6rem 0.8rem;
        border: 1px solid #ced4da;
        border-radius: 6px;
        font-size: 1rem;
        outline: none;
    }

    .editor-input:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.15);
    }

    .text-danger {
        color: #dc3545;
        font-size: 0.85rem;
        margin-top: 0.25rem;
        display: block;
    }

    .editor-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid #e9ecef;
    }

    .editor-input-sm {
        padding: 0.4rem 0.6rem;
        border: 1px solid #ced4da;
        border-radius: 4px;
    }

    .btn-submit {
        background-color: #0d6efd;
        color: #ffffff;
        border: none;
        padding: 0.65rem 1.5rem;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-submit:hover {
        background-color: #0b5ed7;
    }

    .ql-toolbar {
        border-top-left-radius: 6px;
        border-top-right-radius: 6px;
        background: #f8f9fa;
    }

    .ql-container {
        border-bottom-left-radius: 6px;
        border-bottom-right-radius: 6px;
        font-size: 1rem;
    }
</style>

<!-- Script de Quill.js -->
<script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Inicialización de Quill con barra de herramientas limpia
        var quill = new Quill('#quill-editor', {
            theme: 'snow',
            placeholder: 'Escribe aquí el contenido del artículo...',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ 'color': [] }],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    ['link', 'image', 'code-block'],
                    ['clean']
                ]
            }
        });

        // Personalización del botón de subir imágenes para enviar al servidor C#
        quill.getModule('toolbar').addHandler('image', function () {
            var fileInput = document.createElement('input');
            fileInput.setAttribute('type', 'file');
            fileInput.setAttribute('accept', 'image/*');
            fileInput.click();

            fileInput.onchange = function () {
                var file = fileInput.files[0];
                if (file) {
                    var formData = new FormData();
                    formData.append('file', file);

                    fetch('/Admin/Blog/UploadImage', {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => response.json())
                    .then(data => {
                        var imageUrl = data.location || (data.result && data.result[0] ? data.result[0].url : null);
                        if (imageUrl) {
                            var range = quill.getSelection(true);
                            quill.insertEmbed(range.index, 'image', imageUrl);
                        } else {
                            alert('No se pudo subir la imagen.');
                        }
                    })
                    .catch(error => {
                        console.error('Error al subir imagen:', error);
                        alert('Error al conectar con el servidor.');
                    });
                }
            };
        });

        // Sincronizar el contenido HTML del editor con el input oculto al enviar el formulario
        var form = document.getElementById('blogForm');
        form.addEventListener('submit', function () {
            var html = quill.root.innerHTML;
            document.getElementById('editorContent').value = (html === '<p><br></p>') ? '' : html;
        });

        // Generar el Slug automáticamente al escribir el Título
        document.getElementById('Title').addEventListener('input', function () {
            const slugInput = document.getElementById('Slug');
            slugInput.value = this.value
                .toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/[^a-z0-9 -]/g, '')
                .trim()
                .replace(/\s+/g, '-');
        });
    });
</script>