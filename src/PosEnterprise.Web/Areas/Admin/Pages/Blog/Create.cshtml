@page
@model PosEnterprise.Web.Areas.Admin.Pages.Blog.CreateModel
@{
    ViewData["Title"] = "Redactar Artículo - Administración";
}

<!-- Estilos de Quill.js y Fuentes -->
<link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet" />

<div class="w-full max-w-5xl mx-auto px-margin-mobile md:px-margin py-space-lg md:py-space-xl">
    
    <!-- Navegación de Migas de Pan (Breadcrumbs) -->
    <div class="flex items-center justify-between gap-space-sm mb-space-lg">
        <nav class="flex items-center gap-space-xs font-label-md text-label-md text-on-surface-variant flex-wrap">
            <span class="material-symbols-outlined text-[16px]">admin_panel_settings</span>
            <span>Admin</span>
            <span class="text-outline-variant">/</span>
            <span>Blog</span>
            <span class="text-outline-variant">/</span>
            <span class="text-on-surface font-semibold">Redactar Nuevo Artículo</span>
        </nav>
    </div>

    <!-- Contenedor Principal Estilo Moderno -->
    <div class="w-full bg-surface-container-lowest rounded-xl shadow-sm p-space-md sm:p-space-lg md:p-space-xl flex flex-col gap-space-xl border border-surface-container-high/60">
        
        <!-- Encabezado de la Sección -->
        <div class="pb-space-md border-b border-surface-container-low">
            <h1 class="font-headline-lg text-headline-lg text-on-surface font-semibold tracking-tight">
                Redactar Nuevo Artículo
            </h1>
            <p class="font-body-md text-body-md text-on-surface-variant mt-1">
                Crea y publica artículos técnicos para el blog de POS Enterprise.
            </p>
        </div>

        <form method="post" id="blogForm" class="flex flex-col gap-space-lg">
            
            <!-- Título del Artículo -->
            <div class="flex flex-col gap-space-xs">
                <label asp-for="Input.Title" class="font-label-lg text-label-lg text-on-surface font-semibold">
                    Título del Artículo <span class="text-error font-bold">*</span>
                </label>
                <input asp-for="Input.Title" id="Title" class="w-full h-12 px-space-md rounded-lg bg-surface-container-low text-on-surface font-title-md text-title-md placeholder:text-outline/60 focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container focus:outline-none transition-all" placeholder="Título del artículo..." />
                <span asp-validation-for="Input.Title" class="text-xs text-error font-medium mt-0.5"></span>
            </div>

            <!-- Slug Oculto (Autogenerado por JS) -->
            <input type="hidden" asp-for="Input.Slug" id="Slug" />

            <!-- Summary / Extracto -->
            <div class="flex flex-col gap-space-xs">
                <label asp-for="Input.Summary" class="font-label-lg text-label-lg text-on-surface font-semibold">
                    Summary / Extracto <span class="text-error font-bold">*</span>
                </label>
                <textarea asp-for="Input.Summary" id="Summary" rows="2" class="w-full px-space-md py-space-sm rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md placeholder:text-outline/60 focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container focus:outline-none transition-all resize-none" placeholder="Breve resumen del artículo para buscadores..."></textarea>
                <span asp-validation-for="Input.Summary" class="text-xs text-error font-medium mt-0.5"></span>
            </div>

            <!-- Editor WYSIWYG Quill.js (Filtrado exactamente con las opciones requeridas) -->
            <div class="flex flex-col gap-space-xs">
                <label class="font-label-lg text-label-lg text-on-surface font-semibold">
                    Contenido del Artículo <span class="text-error font-bold">*</span>
                </label>
                
                <input type="hidden" asp-for="Input.Content" id="editorContent" />
                
                <div class="rounded-xl overflow-hidden shadow-sm border border-surface-container-high" id="quillWrapper">
                    <div id="quill-editor" style="min-height: 320px;" class="bg-surface-container-lowest font-body-lg text-body-lg text-on-surface"></div>
                </div>
                <span asp-validation-for="Input.Content" class="text-xs text-error font-medium mt-0.5"></span>
            </div>

            <!-- Opciones y Metadatos de Publicación -->
            <div class="bg-surface-container-low rounded-xl p-space-md sm:p-space-lg flex flex-col md:flex-row items-center justify-between gap-space-md">
                
                <!-- Campo Autor -->
                <div class="flex flex-col gap-1 w-full md:w-1/2">
                    <label asp-for="Input.Author" class="font-label-md text-label-md text-on-surface font-semibold">Autor:</label>
                    <input asp-for="Input.Author" id="Author" class="w-full h-10 px-space-sm rounded-lg bg-surface-container-lowest text-on-surface font-body-md text-body-md border border-outline-variant/40 focus:outline-none focus:ring-2 focus:ring-primary-container" />
                    <span asp-validation-for="Input.Author" class="text-xs text-error font-medium"></span>
                </div>

                <!-- Checkbox Publicar -->
                <div class="flex items-center gap-space-xs cursor-pointer select-none self-start md:self-center pt-2 md:pt-0">
                    <input asp-for="Input.IsPublished" id="IsPublished" type="checkbox" class="w-5 h-5 rounded text-primary-container focus:ring-primary-container accent-primary-container cursor-pointer" />
                    <label asp-for="Input.IsPublished" class="font-label-md text-label-md text-on-surface font-medium cursor-pointer">
                        Publicar en el Blog
                    </label>
                </div>
            </div>

            <!-- Botones de Acción -->
            <div class="flex items-center justify-end gap-space-md pt-space-md">
                <a asp-page="/Blog/Index" class="px-space-lg py-2.5 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant font-label-lg text-label-lg transition-colors">
                    Cancelar
                </a>
                <button type="submit" class="px-space-xl py-3 rounded-full bg-primary-container hover:bg-primary text-on-primary font-label-lg text-label-lg font-semibold shadow-md hover:shadow-lg transition-all active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer">
                    <span class="material-symbols-outlined text-[20px]">save</span>
                    <span>Guardar y Publicar</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Estilos para integrar Quill.js con la estética moderna de Tailwind -->
<style>
    .ql-toolbar.ql-snow {
        background-color: #eff4ff !important;
        border: none !important;
        border-bottom: 1px solid #c3c6d7 !important;
        padding: 8px 12px !important;
    }
    .ql-container.ql-snow {
        border: none !important;
        font-family: 'Inter', sans-serif !important;
    }
    .ql-editor {
        padding: 16px !important;
        min-height: 280px;
    }
</style>

<!-- Script de Inicialización y Lógica de Quill.js -->
<script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Inicialización de Quill con ÚNICAMENTE las funciones indicadas
        var quill = new Quill('#quill-editor', {
            theme: 'snow',
            placeholder: 'Escribe aquí el contenido del artículo...',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ 'color': [] }],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    ['link', 'image', 'code-block'],
                    ['clean']
                ]
            }
        });

        // Manejador personalizado para subir imágenes a C#
        quill.getModule('toolbar').addHandler('image', function () {
            var fileInput = document.createElement('input');
            fileInput.setAttribute('type', 'file');
            fileInput.setAttribute('accept', 'image/*');
            fileInput.click();

            fileInput.onchange = function () {
                var file = fileInput.files[0];
                if (file) {
                    var formData = new FormData();
                    formData.append('file', file);

                    fetch('/Admin/Blog/UploadImage', {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => response.json())
                    .then(data => {
                        var imageUrl = data.location || (data.result && data.result[0] ? data.result[0].url : null);
                        if (imageUrl) {
                            var range = quill.getSelection(true);
                            quill.insertEmbed(range.index, 'image', imageUrl);
                        } else {
                            alert('No se pudo subir la imagen.');
                        }
                    })
                    .catch(error => {
                        console.error('Error al subir imagen:', error);
                        alert('Error al conectar con el servidor.');
                    });
                }
            };
        });

        // Sincronizar HTML antes de enviar
        var form = document.getElementById('blogForm');
        form.addEventListener('submit', function () {
            var html = quill.root.innerHTML;
            document.getElementById('editorContent').value = (html === '<p><br></p>') ? '' : html;
        });

        // Generar Slug automáticamente
        document.getElementById('Title').addEventListener('input', function () {
            const slugInput = document.getElementById('Slug');
            slugInput.value = this.value
                .toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/[^a-z0-9 -]/g, '')
                .trim()
                .replace(/\s+/g, '-');
        });
    });
</script>