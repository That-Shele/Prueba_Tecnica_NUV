@page "{id:int}"
@model PosEnterprise.Web.Areas.Admin.Pages.Blog.DeleteModel
@{
    ViewData["Title"] = "Confirmar Eliminación";
}

<div style="max-width: 600px; margin: 3rem auto; padding: 2rem; border: 1px solid #dc3545; border-radius: 8px;">
    <h2>¿Confirmas la eliminación de este artículo?</h2>
    <br />
    <p><strong>Título:</strong> @Model.Article.Title</p>
    <p><strong>Autor:</strong> @Model.Article.Author</p>
    <p><strong>Slug:</strong> @Model.Article.Slug</p>
    <br />

    <form method="post">
        <input type="hidden" asp-for="Article.Id" />
        <button type="submit" style="background-color: red; color: white; border: none; padding: 0.75rem 1.5rem; cursor: pointer; border-radius: 4px;">Confirmar y Eliminar</button>
        <a asp-page="/Blog/Index" style="margin-left: 1rem; color: #6c757d; text-decoration: none;">Cancelar</a>
    </form>
</div>